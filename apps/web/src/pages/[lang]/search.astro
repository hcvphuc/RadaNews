---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SearchBox from "@/components/SearchBox.astro";
import type { Lang } from "@/lib/schema";

export function getStaticPaths() {
  return [{ params: { lang: "vi" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as Lang;
---

<BaseLayout title="Search - AI Radar" lang={lang} active="search">
  <section class="search-page shell">
    <div>
      <span>Search</span>
      <h1>{lang === "vi" ? "Tìm bài viết, prompt và chủ đề AI" : "Search articles, prompts, and AI topics"}</h1>
    </div>
    <SearchBox lang={lang} />
  </section>
</BaseLayout>

<style>
  .search-page {
    display: grid;
    gap: 24px;
    padding: 84px 0 28px;
  }

  span {
    color: #ffb347;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    max-width: 880px;
    margin: 10px 0 0;
    font-size: clamp(38px, 5vw, 70px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
</style>
