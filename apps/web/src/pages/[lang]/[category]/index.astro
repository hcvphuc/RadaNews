---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { categories, categoryById } from "@/lib/categories";
import { getArticlesByCategory } from "@/lib/content";
import type { Category, Lang } from "@/lib/schema";

export function getStaticPaths() {
  return ["vi", "en"].flatMap((lang) => categories.map((category) => ({ params: { lang, category: category.id } })));
}

const lang = Astro.params.lang as Lang;
const category = Astro.params.category as Category;
const categoryMeta = categoryById[category];
const items = getArticlesByCategory(lang, category);
---

<BaseLayout title={`${categoryMeta.label} - AI Radar`} lang={lang} active={category}>
  <!-- Banner -->
  <section class="category-banner shell">
    <div class="banner-bg"></div>
    <div class="banner-body">
      <span>{categoryMeta.label}</span>
      <h1>{categoryMeta.description}</h1>
      <p>
        {lang === "vi"
          ? "Mỗi bài là editorial analysis gốc, có nguồn rõ ràng và được viết cho creator/builder."
          : "Each article is original editorial analysis with clear sources, written for creators and builders."}
      </p>
    </div>
  </section>

  <!-- Article Grid -->
  <section class="article-grid shell">
    {items.map((article) => <ArticleCard article={article} />)}
  </section>
</BaseLayout>

<style>
  .category-banner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    min-height: 330px;
    margin: 56px auto 28px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(43, 46, 51, 0.92);
    background: var(--surface);
    box-shadow: 0 26px 90px rgba(0, 0, 0, 0.42);
  }

  .banner-bg {
    background: linear-gradient(135deg, rgba(24, 26, 29, 0.95), rgba(17, 18, 20, 0.8));
    background-size: cover;
    background-position: center;
    min-height: 100%;
  }

  .banner-body {
    display: grid;
    align-content: center;
    gap: 16px;
    padding: 32px;
  }

  .banner-body span {
    color: #ffb347;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .banner-body h1 {
    margin: 0;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-family: 'Noto Serif', Georgia, serif;
    font-weight: 700;
  }

  .banner-body p {
    margin: 0;
    color: #b9bcc4;
    font-size: 16px;
    line-height: 1.65;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 980px) {
    .category-banner,
    .article-grid {
      grid-template-columns: 1fr;
    }

    .banner-bg {
      min-height: 220px;
    }
  }
</style>
