---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import {
  articleUrl,
  formatDate,
  getAllStaticArticlePaths,
  getLanguageVariant,
  getRelatedArticles,
  readingMeta,
} from "@/lib/content";
import { localizeCategory } from "@/lib/categories";
import type { Article, ContentBlock, MediaBlock, InsightBlock, ArticleSection, HighlightItem, TakeawayBlock, Source } from "@/lib/schema";

export function getStaticPaths() {
  return getAllStaticArticlePaths();
}

const { article } = Astro.props as { article: Article };
const otherLang = article.lang === "vi" ? "en" : "vi";
const otherVariant = getLanguageVariant(article, otherLang);
const relatedArticles = getRelatedArticles(article);

function bgStyle(src: string | undefined): string {
  return src ? "background-image: url(" + src + ")" : "";
}
---

<BaseLayout title={`${article.title} - AI Radar`} lang={article.lang} active={article.category}>
  <article class="article shell" data-bookmark-card={article.id}>

    <!-- ═══ 1. Article Header ═══ -->
    <header class="article-header">
      <div class="article-meta">
        <span>{localizeCategory(article.category, article.lang)}</span>
        <span>{formatDate(article.publishedAt, article.lang)}</span>
        <span>{readingMeta(article, article.lang)}</span>
      </div>
      <h1>{article.title}</h1>
      {article.subtitle && <p>{article.subtitle}</p>}
      <div class="article-actions">
        {otherVariant && <a class="btn-secondary" href={articleUrl(otherVariant)}>{otherLang.toUpperCase()} Version</a>}
        <button class="btn-secondary bookmark-button" type="button" data-bookmark={article.id}>
          <Icon name="bookmark" size={16} /> Save
        </button>
      </div>
    </header>

    <div class="article-layout">
      <!-- Left: TOC -->
      <aside class="toc thin-panel">
        <strong>AI Radar</strong>
        <a href="#highlights">Điểm đáng chú ý</a>
        {article.sections.map((section) => (
          <a href={"#" + section.id}>{section.heading}</a>
        ))}
        {article.insightBlocks && article.insightBlocks.length > 0 && <a href="#insights">Phân tích</a>}
        {article.takeaway && <a href="#takeaway">{article.takeaway.title || "Takeaway"}</a>}
        <a href="#sources">Sources</a>
      </aside>

      <!-- Center: Main content -->
      <div class="article-main">

        <!-- ═══ 2. Hero Media ═══ -->
        {article.heroMedia && (
          <figure class="hero-media" aria-hidden="true">
            <img src={article.heroMedia.src} alt={article.heroMedia.alt} loading="eager" />
            {(article.heroMedia.caption || article.heroMedia.credit) && (
              <figcaption>
                {article.heroMedia.caption}
                {article.heroMedia.credit && (
                  <span class="hero-credit"> · {article.heroMedia.credit}</span>
                )}
              </figcaption>
            )}
          </figure>
        )}

        <!-- ═══ 3. Highlights ═══ -->
        {article.highlights && article.highlights.length > 0 && (
          <section id="highlights" class="highlights-card panel">
            <div class="highlights-head">
              <h2>Điểm đáng chú ý</h2>
              <Icon name="spark" size={16} />
            </div>
            <ol class="highlights-list">
              {article.highlights.map((item, idx) => (
                <li>
                  <span class="hl-num">{String(idx + 1).padStart(2, "0")}</span>
                  <span>{item.text}</span>
                </li>
              ))}
            </ol>
          </section>
        )}

        <!-- ═══ 4. Main Content (Sections) ═══ -->
        {article.sections.map((section) => (
          <section id={section.id} class="article-section">
            <h3 class="section-heading">{section.heading}</h3>
            {section.subheading && <p class="section-subheading">{section.subheading}</p>}
            <div class="section-body">
              {section.blocks.map((block) => (
                <Fragment>
                  {block.type === "paragraph" && block.text && (
                    <p>{block.text}</p>
                  )}
                  {block.type === "list" && block.items && (
                    <ul>
                      {block.items.map((li) => <li>{li}</li>)}
                    </ul>
                  )}
                  {block.type === "media" && block.src && (
                    <figure class="inline-media">
                      <img src={block.src} alt={block.alt || section.heading} loading="lazy" />
                      {(block.caption || block.credit) && (
                        <figcaption>
                          {block.caption}
                          {block.credit && (
                            block.sourceUrl
                              ? <> · <a href={block.sourceUrl} target="_blank" rel="noreferrer">{block.credit}</a></>
                              : <> · {block.credit}</>
                          )}
                        </figcaption>
                      )}
                    </figure>
                  )}
                  {block.type === "callout" && block.text && (
                    <aside class={"callout callout-" + (block.variant || "note")}>
                      {block.title && <strong>{block.title}</strong>}
                      <p>{block.text}</p>
                    </aside>
                  )}
                  {block.type === "quote" && block.text && (
                    <blockquote>
                      <p>{block.text}</p>
                      {block.attribution && <cite>{block.attribution}</cite>}
                    </blockquote>
                  )}
                  {block.type === "code" && block.code && (
                    <pre><code class={block.language ? "language-" + block.language : ""}>{block.code}</code></pre>
                  )}
                </Fragment>
              ))}
            </div>
          </section>
        ))}

        <!-- ═══ 5. Insight / Analysis Blocks ═══ -->
        {article.insightBlocks && article.insightBlocks.length > 0 && (
          <section id="insights" class="insights-section">
            {article.insightBlocks.map((block) => (
              <div class={"insight-card panel insight-" + (block.variant || "analysis")}>
                <div class="insight-head">
                  <h3>{block.title}</h3>
                  <Icon name="spark" size={14} />
                </div>
                <p>{block.text}</p>
              </div>
            ))}
          </section>
        )}

        <!-- ═══ 6. Takeaway ═══ -->
        {article.takeaway && (
          <section id="takeaway" class="takeaway-card panel">
            <div class="takeaway-head">
              <h2>{article.takeaway.title || "Takeaway"}</h2>
              <Icon name="spark" size={16} />
            </div>
            {article.takeaway.text && <p>{article.takeaway.text}</p>}
            {article.takeaway.items && article.takeaway.items.length > 0 && (
              <ul>
                {article.takeaway.items.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </section>
        )}

        <!-- ═══ 7. Sources ═══ -->
        <section id="sources" class="sources-section panel">
          <div class="sources-head">
            <h2>Sources</h2>
            <span>{article.sources.length} nguồn tham khảo</span>
          </div>
          <div class="sources-list">
            {article.sources.map((source, idx) => (
              <a class="source-item" href={source.url} target="_blank" rel="noreferrer">
                <span class="source-num">{String(idx + 1).padStart(2, "0")}</span>
                <div class="source-copy">
                  <strong>{source.title}</strong>
                  <small>{source.publisher} · {source.publishedAt ? source.publishedAt.slice(0, 10) : ""}</small>
                </div>
              </a>
            ))}
          </div>
        </section>
      </div>

      <!-- Right: Related sidebar -->
      {relatedArticles.length > 0 && (
        <aside class="related-sidebar">
          <div class="related-heading">
            <h3>Bài viết cùng chuyên mục</h3>
          </div>
          <div class="related-list">
            {relatedArticles.map((related) => (
              <a class="related-item" href={articleUrl(related)}>
                <div class="related-thumb" style={bgStyle(related.heroMedia?.src)}></div>
                <div class="related-copy">
                  <span class="related-time">{formatDate(related.publishedAt, article.lang)}</span>
                  <strong>{related.title}</strong>
                </div>
              </a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  /* ── Layout ── */
  .article { padding: 72px 0 28px; }
  .article-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 300px;
    gap: 32px;
    align-items: start;
  }

  /* ── 1. Header ── */
  .article-header { max-width: 980px; display: grid; gap: 18px; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 10px; color: var(--muted); font-size: 12px; }
  .article-meta span:first-child { color: #ffb347; font-weight: 800; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(38px, 5.5vw, 78px); line-height: 0.96; letter-spacing: -0.045em; }
  .article-header p { max-width: 780px; margin: 0; color: #c4c7ce; font-size: 18px; line-height: 1.65; }
  .article-actions { display: flex; flex-wrap: wrap; gap: 10px; }

  /* ── 2. Hero Media ── */
  .hero-media {
    margin: 32px 0;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(43, 46, 51, 0.8);
  }
  .hero-media img { width: 100%; display: block; }
  .hero-media figcaption {
    padding: 10px 16px; font-size: 12px; color: var(--muted);
    background: rgba(17, 18, 20, 0.85);
  }
  .hero-credit { color: #ffb347; }

  /* ── 3. Highlights Card ── */
  .highlights-card { padding: 20px 24px; margin-bottom: 28px; }
  .highlights-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; color: #ffb347; }
  .highlights-head h2 { margin: 0; font-size: 16px; color: white; }
  .highlights-list { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .highlights-list li { display: grid; grid-template-columns: 32px 1fr; gap: 12px; align-items: baseline; color: #d7d9de; line-height: 1.6; font-size: 14px; }
  .hl-num { color: #ffb347; font-weight: 800; font-size: 13px; }

  /* ── 4. Sections ── */
  .article-section { margin-bottom: 28px; }
  .section-heading { font-size: 22px; font-weight: 700; margin: 0 0 12px; color: white; letter-spacing: -0.02em; }
  .section-subheading { color: var(--muted); font-size: 14px; margin: -8px 0 16px; }
  .section-body { display: grid; gap: 14px; }
  .section-body p { color: #d7d9de; line-height: 1.72; font-size: 15px; }
  .section-body ul { display: grid; gap: 8px; padding-left: 20px; margin: 0; }
  .section-body li { color: #d7d9de; line-height: 1.65; }

  /* Inline media */
  .inline-media { margin: 20px 0; border-radius: 10px; overflow: hidden; border: 1px solid rgba(43, 46, 51, 0.7); }
  .inline-media img { width: 100%; display: block; }
  .inline-media figcaption { padding: 8px 14px; font-size: 11px; color: var(--muted); background: rgba(17, 18, 20, 0.8); }
  .inline-media figcaption a { color: #ffb347; }

  /* Callout */
  .callout { padding: 14px 16px; border-radius: 10px; border: 1px solid rgba(43, 46, 51, 0.7); }
  .callout strong { display: block; font-size: 12px; color: #ffb347; text-transform: uppercase; margin-bottom: 6px; }
  .callout p { margin: 0; font-size: 13px; color: #b9bcc4; line-height: 1.6; }
  .callout-note { background: rgba(255, 138, 0, 0.06); }
  .callout-technical { background: rgba(100, 100, 255, 0.06); border-color: rgba(100, 100, 255, 0.25); }
  .callout-warning { background: rgba(255, 100, 100, 0.06); border-color: rgba(255, 100, 100, 0.25); }
  .callout-insight { background: rgba(255, 138, 0, 0.1); border-color: rgba(255, 138, 0, 0.3); }
  .callout-context { background: rgba(100, 200, 200, 0.06); border-color: rgba(100, 200, 200, 0.25); }

  /* Blockquote */
  blockquote { margin: 16px 0; padding: 14px 18px; border-left: 3px solid #ffb347; border-radius: 0 8px 8px 0; background: rgba(255, 138, 0, 0.05); }
  blockquote p { margin: 0; font-style: italic; color: #c4c7ce; }
  cite { display: block; margin-top: 8px; font-size: 12px; color: var(--muted); font-style: normal; }

  /* Code */
  pre { margin: 16px 0; padding: 16px; border-radius: 10px; border: 1px solid rgba(43, 46, 51, 0.7); background: rgba(11, 12, 12, 0.8); overflow-x: auto; }
  code { font-size: 13px; color: #c4c7ce; }

  /* ── 5. Insight Blocks ── */
  .insights-section { display: grid; gap: 14px; margin: 28px 0; }
  .insight-card { padding: 18px 20px; }
  .insight-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
  .insight-head h3 { margin: 0; font-size: 15px; color: #ffb347; }
  .insight-card p { margin: 0; color: #d7d9de; font-size: 14px; line-height: 1.65; }

  /* ── 6. Takeaway ── */
  .takeaway-card { padding: 20px 24px; margin: 28px 0; background: linear-gradient(180deg, rgba(24, 26, 29, 0.95), rgba(17, 18, 20, 0.95)); }
  .takeaway-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
  .takeaway-head h2 { margin: 0; font-size: 18px; color: white; }
  .takeaway-card p { color: #d7d9de; line-height: 1.65; font-size: 14px; }
  .takeaway-card ul { display: grid; gap: 8px; padding-left: 20px; }
  .takeaway-card li { color: #d7d9de; line-height: 1.55; font-size: 14px; }

  /* ── 7. Sources ── */
  .sources-section { padding: 20px; }
  .sources-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .sources-head h2 { margin: 0; font-size: 18px; color: white; }
  .sources-head span { color: var(--muted); font-size: 12px; }
  .sources-list { display: grid; gap: 8px; }
  .source-item { display: grid; grid-template-columns: 38px 1fr; gap: 6px 12px; padding: 12px 0; border-top: 1px solid rgba(43, 46, 51, 0.7); }
  .source-item:first-child { border-top: none; }
  .source-num { grid-row: span 2; color: #ffb347; font-weight: 800; font-size: 13px; }
  .source-copy strong { font-size: 14px; }
  .source-copy small { color: var(--muted); font-size: 11px; display: block; margin-top: 3px; }

  /* ── TOC ── */
  .toc { position: sticky; top: 116px; padding: 14px; display: grid; gap: 10px; }
  .toc strong { color: #ffb347; font-size: 12px; }
  .toc a { color: var(--muted); font-size: 13px; }

  /* ── Related Sidebar ── */
  .related-sidebar { position: sticky; top: 116px; border-left: 1px solid rgba(43, 46, 51, 0.72); padding-left: 20px; }
  .related-heading { margin-bottom: 16px; }
  .related-heading h3 { margin: 0; color: #ffb347; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em; }
  .related-list { display: grid; gap: 12px; }
  .related-item { display: grid; grid-template-columns: 64px 1fr; gap: 10px; align-items: start; padding: 6px 0; border-bottom: 1px solid rgba(43, 46, 51, 0.42); }
  .related-thumb { width: 64px; height: 48px; border-radius: 6px; background-size: cover; background-position: center; background-color: rgba(24, 26, 29, 0.9); }
  .related-copy { display: grid; gap: 4px; }
  .related-time { color: var(--muted); font-size: 10px; font-weight: 400; }
  .related-copy strong { font-size: 13px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* ── Misc ── */
  [data-bookmarked="true"] .bookmark-button { color: #ff8a00; border-color: rgba(255, 138, 0, 0.55); background: rgba(255, 138, 0, 0.1); }

  /* ── Responsive ── */
  @media (max-width: 1120px) {
    .article-layout { grid-template-columns: 200px minmax(0, 1fr); }
    .related-sidebar { display: none; }
  }
  @media (max-width: 800px) {
    .article-layout { grid-template-columns: 1fr; }
    .toc { position: static; display: flex; flex-wrap: wrap; }
    .related-sidebar { display: none; }
  }
</style>
