---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import {
  articleUrl,
  formatDate,
  getAllStaticArticlePaths,
  getLanguageVariant,
  getRelatedArticles,
  readingMeta
} from "@/lib/content";
import { localizeCategory } from "@/lib/categories";
import type { Article } from "@/lib/schema";

export function getStaticPaths() {
  return getAllStaticArticlePaths();
}

const { article } = Astro.props as { article: Article };
const otherLang = article.lang === "vi" ? "en" : "vi";
const otherVariant = getLanguageVariant(article, otherLang);
const relatedArticles = getRelatedArticles(article);
---

<BaseLayout title={`${article.title} - AI Radar`} lang={article.lang} active={article.category}>
  <article class="article shell" data-bookmark-card={article.id}>
    <header class="article-header">
      <div class="article-meta">
        <span>{localizeCategory(article.category, article.lang)}</span>
        <span>{formatDate(article.publishedAt, article.lang)}</span>
        <span>{readingMeta(article, article.lang)}</span>
      </div>
      <h1>{article.title}</h1>
      <p>{article.subtitle}</p>
      <div class="article-actions">
        {otherVariant && <a class="btn-secondary" href={articleUrl(otherVariant)}>{otherLang.toUpperCase()} Version</a>}
        <button class="btn-secondary bookmark-button" type="button" data-bookmark={article.id}>
          <Icon name="bookmark" size={16} /> Save
        </button>
      </div>
    </header>

    <div class="article-cover hero-cover" aria-hidden="true"
         style={article.imageUrl ? `background-image: url('${article.imageUrl}')` : ""}></div>

    <div class="article-layout">
      <aside class="toc thin-panel">
        <strong>AI Radar</strong>
        <a href="#tldr">TL;DR</a>
        <a href="#analysis">Analysis</a>
        <a href="#why">Why it matters</a>
        <a href="#takeaway">Takeaway</a>
        <a href="#sources">Sources</a>
      </aside>

      <div class="article-main">
        <section id="tldr" class="panel block">
          <div class="block-title">
            <h2>TL;DR</h2>
            <Icon name="spark" size={16} />
          </div>
          <ul>
            {article.tldr.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section id="analysis" class="article-prose">
          {
            (() => {
              const paragraphs = article.bodyMarkdown.split("\n\n");
              const media = article.inlineMedia || [];
              const chunks: Array<{ type: "p" | "media"; content: unknown }> = [];
              let mediaIdx = 0;

              for (let i = 0; i < paragraphs.length; i++) {
                chunks.push({ type: "p", content: paragraphs[i] });
                if (mediaIdx < media.length && i % 2 === 0) {
                  chunks.push({ type: "media", content: media[mediaIdx++] });
                }
              }
              return chunks.map((chunk) => {
                if (chunk.type === "p") {
                  return <p>{String(chunk.content)}</p>;
                }
                const m = chunk.content as {
                  url: string;
                  type: string;
                  sourceName: string;
                  sourceUrl: string;
                };
                return (
                  <figure class="inline-media">
                    {m.type === "image" ? (
                      <img src={m.url} alt={m.sourceName} loading="lazy" />
                    ) : (
                      <div class="video-wrapper">
                        <iframe
                          src={m.url}
                          frameborder="0"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                          allowfullscreen
                        />
                      </div>
                    )}
                    <figcaption>
                      Source: <a href={m.sourceUrl} target="_blank" rel="noreferrer">
                        {m.sourceName}
                      </a>
                    </figcaption>
                  </figure>
                );
              });
            })()
          }
        </section>

        <section id="why" class="panel block">
          <div class="block-title"><h2>Why it matters</h2></div>
          <p>{article.whyItMatters}</p>
        </section>

        <section id="takeaway" class="panel block">
          <div class="block-title"><h2>Creator / Builder Takeaway</h2></div>
          <p>{article.creatorTakeaway}</p>
        </section>

        <section id="sources" class="panel block sources">
          <div class="block-title"><h2>Sources</h2></div>
          {article.sources.map((source, index) => (
            <a href={source.url} target="_blank" rel="noreferrer">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{source.title}</strong>
              <small>{source.sourceName} · {source.usedFor}</small>
            </a>
          ))}
        </section>
      </div>

      {relatedArticles.length > 0 && (
        <aside class="related-sidebar">
          <div class="related-heading">
            <h3>Bài viết cùng chuyên mục</h3>
          </div>
          <div class="related-list">
            {relatedArticles.map((related) => (
              <a class="related-item" href={articleUrl(related)}>
                <div class="related-thumb"
                     style={related.imageUrl ? `background-image: url('${related.imageUrl}')` : ""}>
                </div>
                <div class="related-copy">
                  <span class="related-time">{formatDate(related.publishedAt, article.lang)}</span>
                  <strong>{related.title}</strong>
                </div>
              </a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding: 72px 0 28px;
  }

  .article-header {
    max-width: 980px;
    display: grid;
    gap: 18px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--muted);
    font-size: 12px;
  }

  .article-meta span:first-child {
    color: #ffb347;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 6vw, 86px);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .article-header p {
    max-width: 780px;
    margin: 0;
    color: #c4c7ce;
    font-size: 19px;
    line-height: 1.65;
  }

  .article-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-cover {
    width: 100%;
    height: min(420px, 42vw);
    min-height: 260px;
    border-radius: 16px;
    border: 1px solid rgba(43, 46, 51, 0.92);
    margin: 34px 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 300px;
    gap: 32px;
    align-items: start;
  }

  .toc {
    position: sticky;
    top: 116px;
    padding: 14px;
    display: grid;
    gap: 10px;
  }

  .toc strong {
    color: #ffb347;
    font-size: 12px;
  }

  .toc a {
    color: var(--muted);
    font-size: 13px;
  }

  .article-main {
    display: grid;
    gap: 28px;
  }

  .block {
    padding: 22px;
  }

  .block-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #ffb347;
    margin-bottom: 14px;
  }

  .block h2 {
    margin: 0;
    color: white;
    font-size: 18px;
  }

  .block p,
  li {
    color: #d7d9de;
    line-height: 1.72;
  }

  ul {
    display: grid;
    gap: 11px;
    margin: 0;
    padding-left: 20px;
  }

  .sources {
    display: grid;
    gap: 10px;
  }

  .sources a {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 4px 12px;
    padding: 12px 0;
    border-top: 1px solid rgba(43, 46, 51, 0.84);
  }

  .sources span {
    grid-row: span 2;
    color: #ffb347;
    font-weight: 800;
  }

  .sources small {
    color: var(--muted);
  }

  /* ── Inline media ── */
  .inline-media {
    margin: 24px 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(43, 46, 51, 0.7);
  }

  .inline-media img {
    width: 100%;
    display: block;
  }

  .inline-media .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
  }

  .inline-media .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .inline-media figcaption {
    padding: 8px 14px;
    font-size: 11px;
    color: var(--muted);
    background: rgba(17, 18, 20, 0.8);
  }

  .inline-media figcaption a {
    color: #ffb347;
  }

  /* ── Related sidebar ── */
  .related-sidebar {
    position: sticky;
    top: 116px;
    border-left: 1px solid rgba(43, 46, 51, 0.72);
    padding-left: 20px;
  }

  .related-heading {
    margin-bottom: 16px;
  }

  .related-heading h3 {
    margin: 0;
    color: #ffb347;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .related-list {
    display: grid;
    gap: 12px;
  }

  .related-item {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 10px;
    align-items: start;
    padding: 6px 0;
    border-bottom: 1px solid rgba(43, 46, 51, 0.42);
  }

  .related-thumb {
    width: 64px;
    height: 48px;
    border-radius: 6px;
    background-size: cover;
    background-position: center;
    background-color: rgba(24, 26, 29, 0.9);
  }

  .related-copy {
    display: grid;
    gap: 4px;
  }

  .related-time {
    color: var(--muted);
    font-size: 10px;
    font-weight: 400;
  }

  .related-copy strong {
    font-size: 13px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  [data-bookmarked="true"] .bookmark-button {
    color: #ff8a00;
    border-color: rgba(255, 138, 0, 0.55);
    background: rgba(255, 138, 0, 0.1);
  }

  @media (max-width: 1120px) {
    .article-layout {
      grid-template-columns: 200px minmax(0, 1fr);
    }

    .related-sidebar {
      display: none;
    }
  }

  @media (max-width: 800px) {
    .article-layout {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
      display: flex;
      flex-wrap: wrap;
    }

    .related-sidebar {
      display: none;
    }
  }
</style>
