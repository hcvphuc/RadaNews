---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getGlossaryByCategory } from "@/data/glossary";
import type { Lang } from "@/lib/schema";

export function getStaticPaths() {
  return [
    { params: { lang: "vi" } },
    { params: { lang: "en" } },
  ];
}

const lang = (Astro.params.lang as Lang) || "vi";
const categories = getGlossaryByCategory(lang);
---

<BaseLayout title="Thuật ngữ kỹ thuật - AI Radar" lang={lang} active="glossary">
  <section class="shell" style="padding-top: 48px;">
    <h1 style="font-size: clamp(32px, 4vw, 56px); line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 8px;">
      {lang === "vi" ? "Thuật ngữ kỹ thuật" : "Technical Glossary"}
    </h1>
    <p style="color: var(--muted); margin-bottom: 40px;">
      {lang === "vi"
        ? "Tra cứu nhanh các thuật ngữ AI được dùng trong bài viết trên AI Radar."
        : "Quick reference for AI terms used in AI Radar articles."}
    </p>

    {categories.map((cat) => (
      <section style="margin-bottom: 48px;">
        <h2 style="color: #ffb347; font-size: 20px; margin-bottom: 16px; font-weight: 800; text-transform: uppercase;">
          {cat.label[lang]}
        </h2>
        <div class="glossary-table">
          <table>
            <thead>
              <tr>
                <th style="width: 60px;">#</th>
                <th style="width: 200px;">Keyword</th>
                <th>{lang === "vi" ? "Giải nghĩa" : "Definition"}</th>
              </tr>
            </thead>
            <tbody>
              {cat.entries.map((entry, idx) => (
                <tr>
                  <td class="num">{String(idx + 1).padStart(2, "0")}</td>
                  <td><code>{entry.keyword}</code></td>
                  <td>{entry[lang]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .glossary-table { overflow-x: auto; border-radius: 12px; border: 1px solid rgba(43, 46, 51, 0.7); }
  .glossary-table table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .glossary-table th { text-align: left; padding: 12px 16px; color: #ffb347; font-size: 11px; font-weight: 800; text-transform: uppercase; background: rgba(24, 26, 29, 0.8); border-bottom: 1px solid rgba(43, 46, 51, 0.5); }
  .glossary-table td { padding: 12px 16px; color: #d7d9de; line-height: 1.55; border-bottom: 1px solid rgba(43, 46, 51, 0.3); }
  .glossary-table tr:last-child td { border-bottom: none; }
  .glossary-table .num { color: #ffb347; font-weight: 800; font-size: 13px; }
  .glossary-table code { color: #ffb347; background: rgba(255, 138, 0, 0.08); padding: 2px 6px; border-radius: 4px; font-size: 13px; }
</style>
