---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChatAssistant from "@/components/ChatAssistant.astro";
import type { Lang } from "@/lib/schema";

export function getStaticPaths() {
  return [{ params: { lang: "vi" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as Lang;
---

<BaseLayout title="Chat - AI Radar" lang={lang} active="chat">
  <section class="chat-page shell">
    <div>
      <span>Chat</span>
      <h1>{lang === "vi" ? "Chat với AI Radar index" : "Chat with the AI Radar index"}</h1>
    </div>
    <ChatAssistant lang={lang} />
  </section>
</BaseLayout>

<style>
  .chat-page {
    display: grid;
    gap: 24px;
    padding: 84px 0 28px;
  }

  span {
    color: #ffb347;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    max-width: 880px;
    margin: 10px 0 0;
    font-size: clamp(38px, 5vw, 70px);
    line-height: 0.98;
  }
</style>
