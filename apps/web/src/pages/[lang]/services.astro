---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Lang } from "@/lib/schema";

export function getStaticPaths() {
  return [{ params: { lang: "vi" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as Lang;
const isVi = lang === "vi";
const contactEmail = "Kianhouses@gmail.com";
const subject = encodeURIComponent(isVi ? "Đặt audit workflow AI video $99" : "Book $99 AI video workflow audit");
const body = encodeURIComponent(
  isVi
    ? "Mình muốn đặt gói audit workflow AI video $99. Đây là mô tả workflow hiện tại của mình:"
    : "I want to book the $99 AI video workflow audit. Here is my current workflow:"
);
---

<BaseLayout
  title={isVi ? "Dịch vụ AI Production - AI Radar" : "AI Production Services - AI Radar"}
  description={
    isVi
      ? "Audit workflow AI video, prompt và production pipeline cho creator/studio muốn giảm lỗi, giảm thời gian render và tăng tỉ lệ shot dùng được."
      : "AI video workflow, prompt, and production pipeline audits for creators/studios that need fewer errors and more usable shots."
  }
  lang={lang}
  active="services"
>
  <section class="services shell">
    <div class="hero panel">
      <span class="eyebrow">AI Production Offer</span>
      <h1>
        {isVi
          ? "Audit workflow AI video trong 48 giờ — $99"
          : "AI video workflow audit in 48 hours — $99"}
      </h1>
      <p>
        {isVi
          ? "Gửi workflow hiện tại: prompt, ảnh reference, tool đang dùng, đoạn output lỗi. Nhận lại một bản chẩn đoán thẳng tay: lỗi nằm ở đâu, sửa thế nào, nên bỏ tool nào, giữ tool nào, và pipeline mới để ra shot ổn định hơn."
          : "Send your current prompts, references, tools, and failed outputs. Get a direct diagnosis: what is broken, what to fix, which tools to drop, which tools to keep, and a cleaner pipeline for more consistent shots."}
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href={`mailto:${contactEmail}?subject=${subject}&body=${body}`}>
          {isVi ? "Đặt audit $99" : "Book the $99 audit"}
        </a>
        <a class="btn-secondary" href={`/${lang}/today`}>{isVi ? "Xem bài phân tích" : "Read analysis"}</a>
      </div>
      <p class="contact-note">
        {isVi ? "Nếu mailto không mở được, gửi trực tiếp tới:" : "If mailto does not open, email directly:"}
        <strong>{contactEmail}</strong>
      </p>
    </div>

    <div class="grid">
      <article class="panel card">
        <span>Deliverable</span>
        <h2>{isVi ? "Bạn nhận được gì" : "What you get"}</h2>
        <ul>
          <li>{isVi ? "1 file audit 3–5 trang: lỗi, nguyên nhân, cách sửa" : "3–5 page audit: issues, causes, fixes"}</li>
          <li>{isVi ? "Pipeline đề xuất theo đúng tool bạn có" : "Recommended pipeline using tools you already have"}</li>
          <li>{isVi ? "Prompt template mới cho image/video/ref frame" : "New prompt templates for image/video/reference frames"}</li>
          <li>{isVi ? "Checklist QC trước khi render hàng loạt" : "QC checklist before batch rendering"}</li>
        </ul>
      </article>

      <article class="panel card">
        <span>Best for</span>
        <h2>{isVi ? "Phù hợp với ai" : "Who it is for"}</h2>
        <ul>
          <li>{isVi ? "Creator làm TVC, film, music video, social ads bằng AI" : "Creators making AI TVCs, films, music videos, social ads"}</li>
          <li>{isVi ? "Studio nhỏ cần chuẩn hóa pipeline trước khi scale" : "Small studios standardizing workflow before scaling"}</li>
          <li>{isVi ? "Người đang kẹt vì shot đẹp nhưng không continuity" : "Teams stuck with pretty shots but no continuity"}</li>
          <li>{isVi ? "Không dành cho người muốn '1 prompt ăn ngay'" : "Not for people looking for a magic one-shot prompt"}</li>
        </ul>
      </article>

      <article class="panel card price-card">
        <span>Price</span>
        <h2>$99</h2>
        <p>{isVi ? "Thanh toán thủ công sau khi xác nhận scope. Không lấy job nếu nhìn qua thấy không cứu được." : "Manual payment after scope confirmation. If the workflow is not salvageable, we will say so before taking the job."}</p>
      </article>
    </div>

    <div class="panel process">
      <span>Process</span>
      <h2>{isVi ? "Quy trình 4 bước" : "4-step process"}</h2>
      <div class="steps">
        <div><strong>01</strong><p>{isVi ? "Bạn gửi tool, prompt, output lỗi, mục tiêu visual." : "You send tools, prompts, failed outputs, visual goal."}</p></div>
        <div><strong>02</strong><p>{isVi ? "Chúng tôi chẩn đoán điểm gãy: prompt, reference, model, seed, timing, edit." : "We diagnose failure points: prompt, reference, model, seed, timing, edit."}</p></div>
        <div><strong>03</strong><p>{isVi ? "Trả bản audit + pipeline mới + prompt template." : "We deliver audit + new pipeline + prompt templates."}</p></div>
        <div><strong>04</strong><p>{isVi ? "Bạn test lại. Nếu lỗi do đề xuất chưa rõ, trả lời follow-up 1 vòng." : "You test. If our recommendation is unclear, one follow-up round is included."}</p></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .services { padding: 72px 0 32px; display: grid; gap: 22px; }
  .hero { padding: clamp(28px, 5vw, 56px); display: grid; gap: 18px; background: radial-gradient(circle at top right, rgba(255, 138, 0, 0.24), transparent 35%), rgba(17, 18, 20, 0.88); }
  .eyebrow, .card span, .process span { color: #ffb347; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; }
  h1 { margin: 0; font-family: 'Noto Serif', Georgia, serif; font-size: clamp(42px, 6vw, 76px); line-height: 0.98; letter-spacing: -0.055em; max-width: 980px; }
  .hero p { margin: 0; color: #d7d9de; max-width: 860px; font-size: 18px; line-height: 1.65; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .btn-primary, .btn-secondary { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 0 18px; border-radius: 10px; font-weight: 800; }
  .btn-primary { color: #121212; background: linear-gradient(135deg, #ffb347, #ff8a00); }
  .btn-secondary { color: #ffb347; border: 1px solid rgba(255, 179, 71, 0.36); background: rgba(255, 138, 0, 0.08); }
  .contact-note { font-size: 13px !important; color: #9ba1aa !important; }
  .contact-note strong { color: #fff; margin-left: 6px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr 0.8fr; gap: 16px; }
  .card, .process { padding: 24px; }
  .card h2, .process h2 { margin: 8px 0 14px; font-size: 26px; letter-spacing: -0.03em; }
  ul { margin: 0; padding-left: 20px; color: #d7d9de; line-height: 1.7; }
  .price-card h2 { font-size: 54px; margin-bottom: 8px; }
  .price-card p { color: #d7d9de; line-height: 1.65; }
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .steps div { border: 1px solid rgba(43, 46, 51, 0.92); border-radius: 14px; padding: 18px; background: rgba(11, 12, 12, 0.48); }
  .steps strong { color: #ffb347; font-size: 13px; }
  .steps p { color: #d7d9de; line-height: 1.55; margin: 10px 0 0; }
  @media (max-width: 980px) { .grid, .steps { grid-template-columns: 1fr; } }
</style>
