---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getArticles } from "@/lib/content";
import type { Lang } from "@/lib/schema";

export function getStaticPaths() {
  return [{ params: { lang: "vi" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as Lang;
const articles = getArticles(lang);
const articlesJson = JSON.stringify(articles);
---

<BaseLayout title="Saved - AI Radar" lang={lang} active="saved">
  <section class="saved shell">
    <div>
      <span>Saved Articles</span>
      <h1>{lang === "vi" ? "Bài viết đã lưu" : "Saved Articles"}</h1>
    </div>
    <div class="panel saved-panel">
      <div id="saved-list" data-lang={lang}></div>
    </div>
  </section>
  <script>
    const articles = JSON.parse(`{articlesJson}`);
    const KEY = "ai-radar.saved";
    const saved = new Set(JSON.parse(localStorage.getItem(KEY) || "[]"));
    const list = document.querySelector("#saved-list");
    const lang = list?.getAttribute("data-lang") || "vi";

    const matches = articles.filter((article) => saved.has(article.id));
    list.innerHTML = matches.length
      ? matches
          .map(
            (article) => `
          <a class="saved-row" href="/${article.lang}/${article.category}/${article.slug}">
            <span>${article.category}</span>
            <strong>${article.title}</strong>
            <small>${article.subtitle}</small>
          </a>`
          )
          .join("")
      : `<p>${lang === "vi" ? "Chưa có bài viết nào được lưu." : "No saved articles yet."}</p>`;
  </script>
</BaseLayout>

<style>
  .saved {
    display: grid;
    gap: 24px;
    padding: 84px 0 28px;
  }

  span {
    color: #ffb347;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 10px 0 0;
    font-size: clamp(38px, 5vw, 70px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .saved-panel {
    padding: 18px;
  }

  #saved-list {
    display: grid;
    gap: 10px;
  }

  #saved-list :global(.saved-row) {
    display: grid;
    gap: 6px;
    padding: 14px;
    border-radius: 12px;
    border: 1px solid rgba(43, 46, 51, 0.86);
    background: rgba(24, 26, 29, 0.55);
  }

  #saved-list :global(strong) {
    color: white;
  }

  #saved-list :global(small),
  #saved-list :global(p) {
    color: var(--muted);
    line-height: 1.5;
  }
</style>
