---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Icon from "@/components/Icon.astro";
import { getArticlesByCategory } from "@/lib/content";
import type { Lang } from "@/lib/schema";

export function getStaticPaths() {
  return [{ params: { lang: "vi" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as Lang;
const imagePrompts = getArticlesByCategory(lang, "prompt-image");
const videoPrompts = getArticlesByCategory(lang, "prompt-video");
---

<BaseLayout title="Prompts - AI Radar" lang={lang} active="prompts">
  <section class="prompts shell">
    <div class="prompt-workspace panel">
      <div class="prompt-head">
        <div>
          <span>Prompt Workflows</span>
          <h1>{lang === "vi" ? "Prompt Image và Prompt Video" : "Prompt Image and Prompt Video"}</h1>
        </div>
        <Icon name="grid" size={22} />
      </div>
      <div class="tabs" role="tablist">
        <button class="active" type="button" data-tab="image">Prompt Image</button>
        <button type="button" data-tab="video">Prompt Video</button>
      </div>
      <div class="prompt-builder">
        <textarea
          placeholder={
            lang === "vi"
              ? "Mô tả chi tiết prompt/workflow bạn muốn tạo..."
              : "Describe the prompt/workflow you want to create..."
          }></textarea>
        <div class="controls">
          <select><option>DALL-E 3</option><option>Midjourney</option><option>Runway</option></select>
          <select><option>1024 × 1024</option><option>16:9</option><option>9:16</option></select>
          <select><option>1:1</option><option>16:9</option><option>9:16</option></select>
          <button class="btn-primary" type="button">Tạo Prompt</button>
        </div>
      </div>
    </div>

    <div class="tab-content" data-panel="image">
      <div class="section-heading">
        <h2>Prompt Image</h2>
        <span>{imagePrompts.length} workflows</span>
      </div>
      <div class="cards">{imagePrompts.map((article) => <ArticleCard article={article} />)}</div>
    </div>
    <div class="tab-content hidden" data-panel="video">
      <div class="section-heading">
        <h2>Prompt Video</h2>
        <span>{videoPrompts.length} workflows</span>
      </div>
      <div class="cards">{videoPrompts.map((article) => <ArticleCard article={article} />)}</div>
    </div>
  </section>
  <script>
    const buttons = document.querySelectorAll("[data-tab]");
    const panels = document.querySelectorAll("[data-panel]");
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const tab = button.getAttribute("data-tab");
        buttons.forEach((item) => item.classList.toggle("active", item === button));
        panels.forEach((panel) => panel.classList.toggle("hidden", panel.getAttribute("data-panel") !== tab));
      });
    });
  </script>
</BaseLayout>

<style>
  .prompts {
    display: grid;
    gap: 22px;
    padding: 72px 0 24px;
  }

  .prompt-workspace {
    padding: 24px;
    display: grid;
    gap: 18px;
  }

  .prompt-head {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    color: #ffb347;
  }

  span {
    color: #ffb347;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1 {
    margin: 8px 0 0;
    font-size: clamp(34px, 4vw, 56px);
    letter-spacing: -0.04em;
  }

  .tabs {
    display: inline-flex;
    width: fit-content;
    padding: 4px;
    border-radius: 10px;
    background: rgba(11, 12, 12, 0.7);
    border: 1px solid rgba(43, 46, 51, 0.92);
  }

  .tabs button {
    height: 36px;
    padding: 0 18px;
    color: var(--muted);
    background: transparent;
    border: 0;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  .tabs button.active {
    color: #ffb347;
    background: rgba(255, 138, 0, 0.14);
  }

  .prompt-builder {
    display: grid;
    gap: 12px;
  }

  textarea {
    min-height: 150px;
    resize: vertical;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid rgba(43, 46, 51, 0.95);
    background: rgba(11, 12, 12, 0.58);
    color: white;
  }

  .controls {
    display: grid;
    grid-template-columns: 180px 180px 120px auto;
    gap: 10px;
  }

  select {
    height: 42px;
    border-radius: 8px;
    border: 1px solid rgba(43, 46, 51, 0.95);
    background: rgba(11, 12, 12, 0.72);
    color: white;
    padding: 0 12px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 24px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .hidden {
    display: none;
  }

  @media (max-width: 850px) {
    .controls,
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
