---
const { lang = "vi" } = Astro.props;
---

<div class="search-panel panel">
  <label for="site-search">Search</label>
  <div class="search-row">
    <input
      id="site-search"
      type="search"
      placeholder="Search articles, topics, models..."
      autocomplete="off"
      autofocus
    />
    <select id="category-filter" aria-label="Category">
      <option value="">All categories</option>
      <option value="ai-agentic">AI Agentic</option>
      <option value="ai-image">AI Image</option>
      <option value="ai-video">AI Video</option>
      <option value="ai-vibe-coding">AI Vibe Coding</option>
      <option value="prompt-image">Prompt Image</option>
      <option value="prompt-video">Prompt Video</option>
    </select>
  </div>
  <div id="search-results" class="results" data-lang={lang}></div>
  <div id="search-status" class="status"></div>
</div>

<script>
  const results = document.querySelector("#search-results");
  const status = document.querySelector("#search-status");
  const input = document.querySelector("#site-search");
  const select = document.querySelector("#category-filter");
  const lang = results?.getAttribute("data-lang") || "vi";

  type SearchRow = {
    id: string;
    lang: string;
    category: string;
    categoryLabel: string;
    title: string;
    subtitle: string;
    tags: string[];
    tldr: string[];
    body: string;
    whyItMatters: string;
    creatorTakeaway: string;
    publishedAt: string;
    readingTime: number;
    url: string;
  };

  let index: SearchRow[] = [];
  let tfidf = new Map<string, Map<string, number>>(); // docId -> {term: tfidf}
  let idf = new Map<string, number>(); // term -> idf
  let allTerms: string[] = [];
  let debounceTimer: ReturnType<typeof setTimeout>;

  function tokenize(text: string): string[] {
    return text
      .toLowerCase()
      .replace(/[^\w\sàáạảãâầấậẩẫăằắặẳẵèéẹẻẽêềếệểễìíịỉĩòóọỏõôồốộổỗơờớợởỡùúụủũưừứựửữỳýỵỷỹđ]/g, " ")
      .split(/\s+/)
      .filter((t) => t.length > 1);
  }

  function docText(doc: SearchRow): string {
    return [
      doc.title,
      doc.subtitle,
      doc.categoryLabel,
      ...doc.tags,
      ...doc.tldr,
      doc.body,
      doc.whyItMatters,
      doc.creatorTakeaway
    ].join(" ");
  }

  async function loadIndex() {
    const response = await fetch("/data/search/articles.json");
    index = await response.json();

    // Build TF-IDF index
    const langDocs = index.filter((d) => d.lang === lang);
    const docTokens: string[][] = [];
    const df = new Map<string, number>(); // document frequency

    for (const doc of langDocs) {
      const tokens = tokenize(docText(doc));
      docTokens.push(tokens);
      const uniqueTokens = new Set(tokens);
      for (const t of uniqueTokens) {
        df.set(t, (df.get(t) || 0) + 1);
      }
    }

    // Compute IDF
    const N = langDocs.length;
    idf.clear();
    allTerms = [...df.keys()];
    for (const [term, count] of df) {
      idf.set(term, Math.log((N + 1) / (count + 1)) + 1); // smoothed IDF
    }

    // Compute TF-IDF per document
    tfidf.clear();
    for (let i = 0; i < langDocs.length; i++) {
      const tokens = docTokens[i];
      const tf = new Map<string, number>();
      for (const t of tokens) {
        tf.set(t, (tf.get(t) || 0) + 1);
      }
      const maxTf = Math.max(...tf.values(), 1);
      const scores = new Map<string, number>();
      for (const [term, freq] of tf) {
        const tfNorm = freq / maxTf;
        const idfVal = idf.get(term) || 0;
        scores.set(term, tfNorm * idfVal);
      }
      tfidf.set(langDocs[i].id, scores);
    }

    render();
  }

  function render() {
    if (!results || !status) return;
    const q = ((input instanceof HTMLInputElement ? input.value : "") || "").toLowerCase().trim();
    const category = (select instanceof HTMLSelectElement ? select.value : "") || "";
    const langDocs = index.filter((d) => d.lang === lang && (!category || d.category === category));

    if (!q) {
      // Show most recent articles when no query
      const recent = langDocs
        .sort((a, b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt))
        .slice(0, 6);
      status.textContent = `Showing ${recent.length} most recent articles`;
      renderResults(recent, "");
      return;
    }

    const queryTokens = tokenize(q);
    const scored = langDocs
      .map((doc) => {
        const scores = tfidf.get(doc.id);
        if (!scores) return { doc, score: 0 };
        let score = 0;
        for (const t of queryTokens) {
          score += scores.get(t) || 0;
        }
        // Boost exact phrase match in title
        if (doc.title.toLowerCase().includes(q)) score += 3;
        if (doc.subtitle.toLowerCase().includes(q)) score += 1.5;
        return { doc, score };
      })
      .filter((m) => m.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 12);

    status.textContent = scored.length
      ? `${scored.length} results for "${q}"`
      : `No results for "${q}"`;

    renderResults(
      scored.map((m) => m.doc),
      q
    );
  }

  function renderResults(items: SearchRow[], query: string) {
    if (!results) return;
    if (items.length === 0) {
      results.innerHTML =
        '<div class="empty">No matching results found. Try different keywords.</div>';
      return;
    }
    results.innerHTML = items
      .map((item) => {
        const meta = `${item.categoryLabel} · ${item.readingTime} min read`;
        return `
          <a class="result" href="${escapeHtml(item.url)}">
            <span>${escapeHtml(meta)}</span>
            <strong>${highlight(escapeHtml(item.title), query)}</strong>
            <small>${highlight(escapeHtml(truncate(item.subtitle, 150)), query)}</small>
          </a>
        `;
      })
      .join("");
  }

  function highlight(text: string, query: string): string {
    if (!query) return text;
    const terms = tokenize(query);
    let result = text;
    for (const t of terms) {
      const escaped = t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const regex = new RegExp(`(${escaped})`, "gi");
      result = result.replace(regex, '<mark class="hl">$1</mark>');
    }
    return result;
  }

  function truncate(text: string, maxLen: number): string {
    return text.length > maxLen ? text.slice(0, maxLen) + "..." : text;
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      };
      return entities[char] || char;
    });
  }

  input?.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(render, 200);
  });
  select?.addEventListener("change", render);
  loadIndex();
</script>

<style>
  .search-panel {
    padding: 20px;
  }

  label {
    display: block;
    margin-bottom: 12px;
    color: white;
    font-weight: 700;
  }

  .search-row {
    display: grid;
    grid-template-columns: 1fr 210px;
    gap: 12px;
  }

  input,
  select {
    height: 46px;
    border-radius: 8px;
    border: 1px solid rgba(43, 46, 51, 0.95);
    background: rgba(11, 12, 12, 0.62);
    color: white;
    padding: 0 14px;
    font-size: 14px;
  }

  input:focus,
  select:focus {
    outline: none;
    border-color: rgba(255, 138, 0, 0.55);
  }

  .status {
    color: var(--muted);
    font-size: 12px;
    margin-top: 12px;
    min-height: 18px;
  }

  .results {
    display: grid;
    gap: 10px;
    margin-top: 8px;
  }

  .result {
    display: grid;
    gap: 5px;
    padding: 14px;
    border: 1px solid rgba(43, 46, 51, 0.86);
    border-radius: 12px;
    background: rgba(24, 26, 29, 0.55);
    transition: border-color 160ms ease, background 160ms ease;
  }

  .result:hover {
    border-color: rgba(255, 138, 0, 0.4);
    background: rgba(24, 26, 29, 0.72);
  }

  .result span {
    color: #ffb347;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .result strong {
    font-size: 15px;
    color: white;
  }

  .result small {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.45;
  }

  :global(.hl) {
    background: rgba(255, 138, 0, 0.22);
    color: #ffb347;
    border-radius: 2px;
    padding: 0 2px;
  }

  .empty {
    border: 1px dashed rgba(255, 179, 71, 0.34);
    border-radius: 8px;
    color: var(--muted);
    padding: 18px;
  }

  @media (max-width: 700px) {
    .search-row {
      grid-template-columns: 1fr;
    }
  }
</style>
